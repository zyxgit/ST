{
  "annotations": { "list": [] },
  "description": "ST 订单 Saga 链路面板 — 下单、库存、支付全链路指标",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    { "title": "全局总览", "url": "/d/st-overview", "type": "link" },
    { "title": "OperationLog", "url": "/d/st-operationlog", "type": "link" }
  ],
  "panels": [
    {
      "title": "下单速率",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }] },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "rate(st_order_created_total[1m])", "legendFormat": "下单/s", "refId": "A", "instant": true }
      ]
    },
    {
      "title": "Saga 补偿次数",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] },
          "unit": "short"
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "st_order_saga_compensated_total", "legendFormat": "Saga补偿", "refId": "A", "instant": true }
      ]
    },
    {
      "title": "库存冻结成功/失败",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "st_inventory_freeze_success_total", "legendFormat": "冻结成功", "refId": "A", "instant": true },
        { "expr": "st_inventory_freeze_failed_total", "legendFormat": "冻结失败", "refId": "B", "instant": true }
      ]
    },
    {
      "title": "支付成功/失败",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "st_payment_succeeded_total", "legendFormat": "支付成功", "refId": "A", "instant": true },
        { "expr": "st_payment_failed_total", "legendFormat": "支付失败", "refId": "B", "instant": true }
      ]
    },
    {
      "title": "下单耗时分布",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(st_order_create_duration_ms_bucket[5m]))", "legendFormat": "P50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, rate(st_order_create_duration_ms_bucket[5m]))", "legendFormat": "P95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, rate(st_order_create_duration_ms_bucket[5m]))", "legendFormat": "P99", "refId": "C" }
      ]
    },
    {
      "title": "库存冻结耗时分布",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(st_inventory_freeze_duration_ms_bucket[5m]))", "legendFormat": "P50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, rate(st_inventory_freeze_duration_ms_bucket[5m]))", "legendFormat": "P95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, rate(st_inventory_freeze_duration_ms_bucket[5m]))", "legendFormat": "P99", "refId": "C" }
      ]
    },
    {
      "title": "Outbox 发布耗时分布",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(st_outbox_publish_duration_ms_bucket[5m]))", "legendFormat": "P50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, rate(st_outbox_publish_duration_ms_bucket[5m]))", "legendFormat": "P95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, rate(st_outbox_publish_duration_ms_bucket[5m]))", "legendFormat": "P99", "refId": "C" }
      ]
    },
    {
      "title": "Saga 事件链路速率",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "lineInterpolation": "smooth", "fillOpacity": 80 },
          "unit": "ops"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "下单" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "取消" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "冻结成功" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "冻结失败" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "释放" }, "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "支付成功" }, "properties": [{ "id": "color", "value": { "fixedColor": "dark-green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "支付失败" }, "properties": [{ "id": "color", "value": { "fixedColor": "dark-red", "mode": "fixed" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "increase(st_order_created_total[5m])", "legendFormat": "下单", "refId": "A" },
        { "expr": "increase(st_order_canceled_total[5m])", "legendFormat": "取消", "refId": "B" },
        { "expr": "increase(st_inventory_freeze_success_total[5m])", "legendFormat": "冻结成功", "refId": "C" },
        { "expr": "increase(st_inventory_freeze_failed_total[5m])", "legendFormat": "冻结失败", "refId": "D" },
        { "expr": "increase(st_inventory_released_total[5m])", "legendFormat": "释放", "refId": "E" },
        { "expr": "increase(st_payment_succeeded_total[5m])", "legendFormat": "支付成功", "refId": "F" },
        { "expr": "increase(st_payment_failed_total[5m])", "legendFormat": "支付失败", "refId": "G" }
      ]
    },
    {
      "title": "Outbox 发布成功率",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 90 }, { "color": "green", "value": 99 }] },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "rate(st_outbox_published_total[5m]) / (rate(st_outbox_published_total[5m]) + rate(st_outbox_failed_total[5m]))", "legendFormat": "成功率", "refId": "A" }
      ]
    },
    {
      "title": "库存释放数",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "blue", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "st_inventory_released_total", "legendFormat": "释放数", "refId": "A", "instant": true }
      ]
    },
    {
      "title": "订单取消数",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "yellow", "value": null }, { "color": "red", "value": 10 }] },
          "unit": "short"
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "st_order_canceled_total", "legendFormat": "取消数", "refId": "A", "instant": true }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["st", "order", "saga"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "ST - 订单 Saga",
  "uid": "st-order-saga",
  "version": 1
}

# ──────────────────────────────────────────────
# ST 轻量部署环境变量 — 2C2G 服务器专用
# 使用方式: cp .env.2c2g.example .env && vim .env
# ──────────────────────────────────────────────

# ──────────────────────────────────────────────
# 数据库
# ──────────────────────────────────────────────
PGUSER=st_user
PGPASSWORD=change_me_password

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis

# ──────────────────────────────────────────────
# RabbitMQ
# ──────────────────────────────────────────────
RABBITUSER=st_rabbit
RABBITPASSWORD=change_me_rabbit

# ──────────────────────────────────────────────
# JWT（生产环境务必换一个复杂密钥）
# ──────────────────────────────────────────────
JWTSIGNINGKEY=wZV55scpx1t43M+pjkiUpsx7WJ3S5yskVzC1Dtn7/NA=

# ──────────────────────────────────────────────
# 数据种子（迁移完成后设为 true 触发初始化数据）
# ──────────────────────────────────────────────
APP_IS_DATA_SEED=false

# ──────────────────────────────────────────────
# 前端访问网关的地址（留空则使用 nginx 反向代理，一般无需设置）
# ──────────────────────────────────────────────
# VITE_API_BASE_URL=

# ──────────────────────────────────────────────
# HTTPS 域名配置（使用 HTTPS 时必须设置）
# ──────────────────────────────────────────────
DOMAIN_NAME=yourdomain.com

# ──────────────────────────────────────────────
# 宿主机端口映射（可改，避免冲突）
# ──────────────────────────────────────────────
POSTGRES_HOST_PORT=25432
REDIS_HOST_PORT=26379
RABBITMQ_AMQP_HOST_PORT=25672
IDENTITY_HOST_PORT=27127
OPERATIONLOG_HOST_PORT=21001
FILEUPLOAD_HOST_PORT=27250
ORDER_HOST_PORT=25090
INVENTORY_HOST_PORT=25091
PAYMENT_HOST_PORT=25092
GATEWAY_HOST_PORT=25000
WEB_HOST_PORT=28080

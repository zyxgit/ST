{
  "$schema": "./migrations.schema.json",
  "description": "ST 微服务迁移配置 — migrate.ps1 / migrate.sh 的服务注册表",
  "services": {
    "identity": {
      "dbContext": "IdentityDbContext",
      "infra": "Api/src/Microservices/Identity/ST.MS.Identity.Infra",
      "api": "Api/src/Microservices/Identity/ST.MS.Identity.Api",
      "database": "st_identity"
    },
    "operationlog": {
      "dbContext": "OperationLogDbContext",
      "infra": "Api/src/Microservices/OperationLog/ST.MS.OperationLog.Infra",
      "api": "Api/src/Microservices/OperationLog/ST.MS.OperationLog.Api",
      "database": "st_operationlog"
    },
    "test": {
      "dbContext": "AppDbContext",
      "infra": "Api/src/Microservices/Test/ST.MS.Test.Infra",
      "api": "Api/src/Microservices/Test/ST.MS.Test.Api",
      "database": "st_test"
    },
    "fileupload": {
      "dbContext": "FileUploadDbContext",
      "infra": "Api/src/Microservices/FileUpload/ST.MS.FileUpload.Infra",
      "api": "Api/src/Microservices/FileUpload/ST.MS.FileUpload.Api",
      "database": "st_fileupload"

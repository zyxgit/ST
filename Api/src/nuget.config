<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<!-- 包源配置 -->
	<packageSources>
		<clear />
		<!-- 清除默认配置，避免冲突 -->
		<!--官方 cdn 加速源-->
		<!--<add key="nuget.cdn.azure" value="https://nuget.cdn.azure.cn/v3/index.json" />-->
		<!-- 官方 NuGet 源 -->
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />

		<!-- 私有 NuGet 源 -->
		<!-- <add key="my-private-feed" value="https://myserver/nuget/v3/index.json" /> -->
	</packageSources>

	<!-- 私有源的凭证配置（仅示例，实际项目建议用环境变量或 Azure DevOps PAT） -->
	<!-- <packageSourceCredentials>
    <my-private-feed>
      <add key="Username" value="your-username" />
      <add key="ClearTextPassword" value="your-password" />
    </my-private-feed>
  </packageSourceCredentials> -->

	<!-- 其他全局设置 -->
	<config>
		<!-- 自定义全局包文件夹（避免每个解决方案都重复下载） -->
		<!-- <add key="globalPackagesFolder" value="D:\NuGetPackages" /> -->
		<!-- 禁用自动还原（如果你不想 VS 自动拉包，可以打开这行） -->
		<!-- <add key="disablePackageRestore" value="true" /> -->
	</config>
</configuration>

<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true"
	  internalLogLevel="Off"
      internalLogFile="logs/nlog-internal.log">

	<!-- ========================= -->
	<!--  全局变量（Host 可覆盖）  -->
	<!-- ========================= -->
	<variable name="logDir" value="logs/${shortdate}" />
	<variable name="appName" value="${processname}" />

	<!-- 开发环境禁用文件日志，避免在项目目录生成 logs 文件夹 -->
	<!-- 通过环境变量 ASPNETCORE_ENVIRONMENT 判断，Development 时不写文件 -->

	<!-- ========================= -->
	<!--  通用日志布局             -->
	<!-- ========================= -->
	<variable name="logLayout" value="【${longdate}】【${level:uppercase=true}】【${logger}】${event-properties:TraceId}  ${newline}${message}${onexception:inner=|${exception:format=ToString}}" />

	<!-- ========================= -->
	<!--  通用 Targets（兜底）     -->
	<!-- ========================= -->
	<targets>
		<target name="console" xsi:type="AsyncWrapper" queueLimit="5000" overflowAction="Discard">
			<target xsi:type="ColoredConsole"
				useDefaultRowHighlightingRules="false"
				layout="${logLayout}">
				<highlight-row condition="level == LogLevel.Debug" foregroundColor ="Blue" />
				<highlight-row condition="level == LogLevel.Info" foregroundColor ="Gray" />
				<highlight-row condition="level == LogLevel.Warn" foregroundColor ="Yellow" />
				<highlight-row condition="level == LogLevel.Error" foregroundColor ="Red" />
				<highlight-row condition="level == LogLevel.Fatal" foregroundColor ="Red" />
			</target>
		</target>
		<!-- 默认文件：所有没被规则接住的日志 -->
		<target name="error_file" xsi:type="AsyncWrapper">
			<target xsi:type="File"
					encoding="utf-8"
					fileName="${logDir}/error.log"
					archiveFileName="${logDir}/error.{###}.log"
					archiveAboveSize="104857600"
					archiveNumbering="Sequence"
					maxArchiveFiles="30"
					layout="${longdate}|${level:uppercase=true}|${logger}|${message}${newline}${onexception:${exception:format=ToString}}${newline}"/>
		</target>
		<target name="info_file" xsi:type="AsyncWrapper">
			<target xsi:type="File"
					encoding="utf-8"
					fileName="${logDir}/info.log"
					archiveFileName="${logDir}/info.{###}.log"
					archiveAboveSize="104857600"
					archiveNumbering="Sequence"
					maxArchiveFiles="30"
					layout="${longdate}|${level}|${logger}|${message}${newline}${onexception:${exception:format=Message}}"/>
		</target>

		<target name="debug_file" xsi:type="AsyncWrapper">
			<target xsi:type="File"
					encoding="utf-8"
					fileName="${logDir}/debug.log"
					archiveFileName="${logDir}/debug.{###}.log"
					archiveAboveSize="104857600"
					archiveNumbering="Sequence"
					maxArchiveFiles="30"
					layout="$【{longdate}】【${level}】【${logger}】${message}${newline}"/>
		</target>

		<target name="request_file" xsi:type="AsyncWrapper">
			<target xsi:type="File"
					encoding="utf-8"
					fileName="${logDir}/request.log"
					archiveFileName="${logDir}/request.{###}.log"
					archiveAboveSize="104857600"
					archiveNumbering="Sequence"
					maxArchiveFiles="30"
					layout="【${longdate}】${message}${newline}" />
		</target>
	</targets>

	<!-- ========================= -->
	<!--  通用 Rules（兜底）       -->
	<!-- ========================= -->
	<rules>
		<!-- 吞系统 Debug / Info -->
		<logger name="Microsoft.*" minlevel="Trace" maxlevel="Info" final="true" />
		<logger name="System.*" minlevel="Trace" maxlevel="Info" final="true" />

		<!-- 吞 Polly 弹性策略的 Debug 日志 -->
		<logger name="Polly*" minlevel="Trace" maxlevel="Info" final="true" />
		<logger name="Microsoft.Extensions.Http.Resilience*" minlevel="Trace" maxlevel="Info" final="true" />

		<!-- 请求日志，单独文件 -->
		<logger name="RequestLogger" minlevel="Info" writeTo="request_file" final="true" />

		<!--  Debug 专用文件 -->
		<logger name="*" minlevel="Debug" maxlevel="Debug" writeTo="debug_file" final="true" />

		<!--  控制台（只输出 Info 及以上，避免生产环境 Debug 刷屏） -->
		<logger name="*" minlevel="Info" writeTo="console" />

		<!--  Info / Warn -->
		<logger name="*" minlevel="Info" maxlevel="Warn" writeTo="info_file" />

		<!--  Error / Fatal -->
		<logger name="*" minlevel="Error" writeTo="error_file" />
	</rules>

</nlog>

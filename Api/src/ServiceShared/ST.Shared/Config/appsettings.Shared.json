{
  "Jwt": {
    "Issuer": "st",
    "Audience": "st",
    "SigningKey": "st-dev-signing-key-change-me-32bytes!!",
    "AccessTokenMinutes": 10,
    "RefreshTokenDays": 14
  },
  "Database": {
    "Provider": "Npgsql"
  },
  "RabbitMQ": {
    "EventBus": {
      "Password": "guest"
    },
    "OperationLog": {
      "Password": "guest"
    }
  },
  "RequestLogging": {
    "Enabled": true,
    "LogBody": false,
    "MaskJsonBody": true,
    "MaxBodyChars": 8192,
    "Mask": "***",
    "SensitiveKeys": [ "password", "pwd", "token", "accessToken", "refreshToken", "secret", "authorization" ],
    "AllowedContentTypes": [ "application/json", "application/*+json", "application/x-www-form-urlencoded" ]
  },
  "OperationLog": {
    "Enabled": true,
    "RecordResponseByDefault": false,
    "MaxBodyLength": 8192,
    "SampleRate": 1.0,
    "MaskEnabled": true,
    "SensitiveKeys": [ "password", "pwd", "token", "accessToken", "refreshToken", "secret", "authorization" ],
    "ChannelCapacity": 10000,
    "DropWhenFull": true,
    "BatchSize": 50,
    "FlushIntervalMs": 500
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "App": {
    "ErrorMessage": "服务异常，会尽快修复",
    "IsCodeFirst": true,
    "IsCreateDatabase": true,
    "IsDataSeed": true
  },
  "RabbitMQ": {
    "OperationLog": {
      "ExchangeName": "st.operationlog",
      "RoutingKey": "operation_log"
    }
  },
  "OperationLog": {
    "Enabled": true,
    "Sinks": [ "rabbitmq" ],
    "RecordResponseByDefault": false,
    "MaxBodyLength": 8192,
    "SampleRate": 1.0,
    "MaskEnabled": true,
    "SensitiveKeys": [ "password", "pwd", "token", "accessToken", "refreshToken", "secret", "authorization" ],
    "ChannelCapacity": 10000,
    "DropWhenFull": true,
    "BatchSize": 50,
    "FlushIntervalMs": 500
  }
}

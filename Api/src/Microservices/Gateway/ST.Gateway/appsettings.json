{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5174"
    ]
  },
  "RateLimiting": {
    "Enabled": true,
    "ApiPermitLimit": 120,
    "AuthPermitLimit": 20,
    "DocsPermitLimit": 240,
    "WindowSeconds": 60
  },
  "ForwardedHeaders": {
    "Enabled": true,
    "ForwardLimit": 1,
    "TrustAll": false,
    "KnownProxies": [
      "127.0.0.1",
      "::1"
    ]
  },
  "AllowedHosts": "*",
  "DownstreamServices": {
    "Identity": {
      "Address": "https://localhost:7127"
    },
    "OperationLog": {
      "Address": "https://localhost:51001"
    },
    "Test": {
      "Address": "http://localhost:5089"
    },
    "FileUpload": {
      "Address": "https://localhost:7250"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-api-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/identity"
          }
        ]
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/identity/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/identity"
          }
        ]
      },
      "identity-docs-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/docs/identity/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/docs/identity"
          }
        ]
      },
      "operationlog-api-route": {
        "ClusterId": "operationlog-cluster",
        "Match": {
          "Path": "/api/operationlog/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/operationlog"
          }
        ]
      },
      "operationlog-route": {
        "ClusterId": "operationlog-cluster",
        "Match": {
          "Path": "/operationlog/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/operationlog"
          }
        ]
      },
      "operationlog-docs-route": {
        "ClusterId": "operationlog-cluster",
        "Match": {
          "Path": "/docs/operationlog/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/docs/operationlog"
          }
        ]
      },
      "test-api-route": {
        "ClusterId": "test-cluster",
        "Match": {
          "Path": "/api/test/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/test"
          }
        ]
      },
      "test-route": {
        "ClusterId": "test-cluster",
        "Match": {
          "Path": "/test/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/test"
          }
        ]
      },
      "test-docs-route": {
        "ClusterId": "test-cluster",
        "Match": {
          "Path": "/docs/test/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/docs/test"
          }
        ]
      },
      "fileupload-api-route": {
        "ClusterId": "fileupload-cluster",
        "Match": {
          "Path": "/api/files/{**catch-all}"
        }
      },
      "fileupload-docs-route": {
        "ClusterId": "fileupload-cluster",
        "Match": {
          "Path": "/docs/fileupload/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/docs/fileupload"
          }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-destination": {
            "Address": "https://localhost:7127"
          }
        }
      },
      "operationlog-cluster": {
        "Destinations": {
          "operationlog-destination": {
            "Address": "https://localhost:51001"
          }
        }
      },
      "test-cluster": {
        "Destinations": {
          "test-destination": {
            "Address": "http://localhost:5089"
          }
        }
      },
      "fileupload-cluster": {
        "Destinations": {
          "fileupload-destination": {
            "Address": "https://localhost:7250"
          }
        }
      }
    }
  }
}

# Shared runtime configuration example
# Copy the needed values into your shell, CI/CD secret store, or user-secrets.

# Database
Database__ConnectionString=Host=localhost;Port=15432;Username=postgres;Password=pw123456;Database=st_operationlog;

# JWT
Jwt__SigningKey=st-dev-signing-key-change-me-32bytes!!

# SMTP
Smtp__Password=replace-with-your-smtp-password

# RabbitMQ
RabbitMQ__EventBus__Password=guest
RabbitMQ__OperationLog__Password=guest

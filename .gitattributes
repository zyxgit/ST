# 默认全部使用 CRLF（Windows 团队与 VS / Vue 工具链一致）
* text eol=crlf

# .NET / 配置与文档
*.cs     text eol=crlf
*.csproj text eol=crlf
*.sln    text eol=crlf
*.props  text eol=crlf
*.targets text eol=crlf
*.json   text eol=crlf
*.xml    text eol=crlf
*.yml    text eol=lf
*.yaml   text eol=crlf
*.md     text eol=crlf

# 前端（Vue / Vite）
*.vue    text eol=crlf
*.ts     text eol=crlf
*.tsx    text eol=crlf
*.mts    text eol=crlf
*.cts    text eol=crlf
*.js     text eol=crlf
*.jsx    text eol=crlf
*.mjs    text eol=crlf
*.cjs    text eol=crlf
*.css    text eol=crlf
*.scss   text eol=crlf
*.sass   text eol=crlf
*.less   text eol=crlf
*.html   text eol=crlf
*.htm    text eol=crlf

# Shell / Linux 脚本 & 环境变量强制 LF（CI、WSL、部署脚本）
*.sh     text eol=lf
*.bash   text eol=lf
*.env    text eol=lf

# 二进制文件（避免被修改）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.dll binary
*.exe binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
